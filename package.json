{
  "name": "oeydesign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  },
  "scripts": {
    "oey": "tsx apps/cli/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test packages/*/test/*.test.ts apps/*/test/*.test.ts",
    "build": "npm run typecheck && tsx scripts/ts/build.ts",
    "check:compat": "tsx scripts/ts/check-compatibility.ts",
    "check:host": "tsx scripts/ts/check-runtime-compatibility.ts",
    "web": "tsx apps/web/src/server/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "test:web": "playwright test --config apps/web/playwright.config.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.25.12",
    "konva": "10.5.0",
    "pptxgenjs": "4.0.1",
    "tsx": "4.23.13",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
