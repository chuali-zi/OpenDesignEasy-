rd h3 { font-size: 21px; margin-bottom: 10px; color: #2f4f43; }\n  .course-card p { font-size: 14px; color: #7a7468; margin-bottom: 18px; min-height: 66px; }\n  .course-info { font-size: 13px; color: #a09a8d; margin-bottom: 18px; }\n  .course-info span { margin-right: 14px; }\n  .course-price { font-size: 22px; font-weight: 700; color: #c98a2d; margin-bottom: 16px; }\n  .course-price small { font-size: 13px; font-weight: 400; color: #a09a8d; }\n  .btn-outline {\n    display: inline-block;\n    width: 100%;\n    text-align: center;\n    background: transparent;\n    color: #2f4f43;\n    font-weight: 600;\n    font-size: 15px;\n    padding: 11px 0;\n    border: 2px solid #2f4f43;\n    border-radius: 10px;\n    cursor: pointer;\n  }\n\n  /* Booking form */\n  .booking { background: #efe9dd; padding: 72px 0; }\n  .booking-box {\n    max-width: 640px;\n    margin: 0 auto;\n    background: #ffffff;\n    border-radius: 18px;\n    padding: 44px 40px;\n    border: 1px solid #e8e2d6;\n  }\n  .form-row { margin-bottom: 20px; }\n  .form-row label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 8px; color: #4a463d; }\n  .form-row input, .form-row select, .form-row textarea {\n    width: 100%;\n    padding: 12px 14px;\n    font-size: 15px;\n    font-family: inherit;\n    border: 1px solid #d8d2c4;\n    border-radius: 10px;\n    background: #fbfaf7;\n    color: #3d3a34;\n  }\n  .form-row textarea { resize: none; height: 88px; }\n  .form-note { font-size: 13px; color: #a09a8d; margin-top: 16px; text-align: center; }\n  .btn-submit { width: 100%; text-align: center; }\n\n  /* Footer */\n  .footer { background: #2f4f43; color: #cfd9d3; padding: 40px 0; text-align: center; }\n  .footer h4 { color: #fdfbf7; font-size: 17px; margin-bottom: 10px; }\n  .footer p { font-size: 14px; margin-bottom: 4px; }\n\n  @media (max-width: 860px) {\n    .course-grid { grid-template-columns: 1fr; }\n    .hero h1 { font-size: 30px; }\n  }\n</style>\n</head>\n<body>\n\n  <section class