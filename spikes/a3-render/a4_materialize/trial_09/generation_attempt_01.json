ackground:#fff; border:1px solid #f0e6da; border-radius:14px; padding:28px 24px; text-align:center; }\n  .card .icon { width:52px; height:52px; margin:0 auto 16px; background:#fff1e2; border-radius:50%; display:flex; align-items:center; justify-content:center; }\n  .card .icon img { width:28px; height:28px; }\n  .card h3 { font-size:17px; margin-bottom:8px; }\n  .card p { font-size:13px; color:#8a7a68; }\n  /* pricing */\n  .pricing { background:#fff8f0; padding:64px 0; }\n  .price-row { display:flex; gap:24px; }\n  .price { flex:1; background:#fff; border-radius:14px; padding:28px 24px; text-align:center; border:1px solid #f0e6da; }\n  .price.featured { border:2px solid #e2711d; }\n  .price h3 { font-size:16px; color:#8a7a68; }\n  .price .num { font-size:34px; font-weight:700; color:#e2711d; margin:8px 0 4px; }\n  .price .num small { font-size:13px; color:#8a7a68; font-weight:400; }\n  .price p { font-size:13px; color:#8a7a68; margin-bottom:18px; }\n  /* footer */\n  .site-footer { background:#3a2e26; color:#cbb9a6; padding:36px 0; text-align:center; font-size:13px; }\n  .site-footer strong { color:#fff; font-size:16px; display:block; margin-bottom:6px; }\n</style>\n</head>\n<body>\n\n<header class=\"site-header\" data-oey-section=\"header\">\n  <div class=\"wrap\">\n    <div class=\"logo\" data-oey-object=\"header.logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"爪印\">\n      暖窝宠物寄养\n    </div>\n    <nav class=\"nav\" data-oey-object=\"header.nav\">\n      <a href=\"#services\">服务</a><a href=\"#pricing\">价格</a><a href=\"#contact\">联系我们</a>\n    </nav>\n  </div>\n</header>\n\n<section class=\"hero\" data-oey-section=\"hero\">\n  <div class=\"wrap\">\n    <div class=\"hero-text\">\n      <span class=\"tag\" data-oey-object=\"hero.tag\">持证照护 · 24小时看护</span>\n      <h1 data-oey-object=\"hero.title\">您放心远行，<br>毛孩子在这里安第二个家</h1>\n      <p data-oey-object=\"hero.desc\">独立恒温房间、每日三次遛弯、实时视频播报。开业八年，已为 12000+ 只猫狗提供安心寄养。</p>\n      <a class=\"btn\" href=\"#contact\" 